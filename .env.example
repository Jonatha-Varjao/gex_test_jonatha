# ── Shared (gex_common) ──────────────────────
# When running bare-metal (uv run ...), point these at localhost.
# When running under docker compose, override DATABASE_URL and RABBITMQ_URL
# to the service names (mysql, rabbitmq) — see docker-compose.yml.
DATABASE_URL=mysql+asyncmy://gex:gex@localhost:3306/gex
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# 32-byte AES key for the grummer gateway, in hex (64 chars). Get it from the
GRUMMER_SECRET_HEX=replace-me-with-the-real-64-char-hex-key
# webhook.site URL for the SMS distributor (per challenge).
WEBHOOK_SITE_URL=https://webhook.site/your-uuid-here
SMS_FAILURE_RATE=0.1
LOG_LEVEL=INFO
ENVIRONMENT=development
# ── Receiver (gex_receiver) ─────────────────
MAX_REQUEST_SIZE_KB=1024
# ── Worker (gex_worker) ──────────────────────
CONSUMER_CONCURRENCY=1
# ── Docker Compose only (not read by Python) ──
MYSQL_ROOT_PASSWORD=gexroot
MYSQL_DATABASE=gex
MYSQL_USER=gex
MYSQL_PASSWORD=gex
RABBITMQ_USER=guest
RABBITMQ_PASS=guest